{
    "name": "NES模拟器",
    "short_name": "FCGame",
    "description": "任天堂FC/NES原版ROM在线玩，可以近乎完美的还原fc卡带游戏的视频和声音。",
    "start_url": "/nes/index.html",
    "scope": "/nes/",
    "id": "/nes/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#d0e7f9",
    "theme_color": "#da4a4a",
    "icons": [
        {
            "src": "/nes/favicon.ico",
            "sizes": "32x32",
            "type": "image/x-icon"
        },
        {
            "src": "/nes/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/nes/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/nes/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "launch_handler": {
        "client_mode": "navigate-new"
    },
    "file_handlers": [
        {
            "action": "/nes/",
            "accept": {
                "application/x-nes-rom": [".nes"]
            }
        }
    ]
}
